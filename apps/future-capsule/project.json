{
  "name": "future-capsule",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/future-capsule",
  "projectType": "application",
  "tags": ["type:app", "scope:frontend"],
  "// targets": "to see all targets run: nx show project future-capsule --web",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/future-capsule",
        "root": "apps/future-capsule"
      },
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "serve": {
      "executor": "@nx/next:serve",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "future-capsule:build",
        "dev": true,
        "root": "apps/future-capsule",
        "port": 3000
      },
      "configurations": {
        "production": {
          "buildTarget": "future-capsule:build:production",
          "dev": false
        },
        "development": {
          "buildTarget": "future-capsule:build:development",
          "dev": true
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "future-capsule:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/future-capsule/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
